# supabase link 후 project settings > API에서 채워넣기
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정에서 발급한 키(JSON 전체를 한 줄로)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# pg_cron이 dispatch-scheduled-triggers 호출 시 사용하는 임의의 값 (아무 랜덤 문자열)
CRON_SECRET=
